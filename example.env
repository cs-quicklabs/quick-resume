## Quick Resume - example environment variables
##
## Copy this file to `.env` (or set these in your deployment environment)
## and replace placeholder values with your Google service account credentials.
##
## Required: Google Sheets (Service Account)
GOOGLE_PROJECT_ID="your-gcp-project-id"
GOOGLE_PRIVATE_KEY_ID="your-private-key-id"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_MATERIAL\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL="your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
GOOGLE_CLIENT_ID="your-client-id"

## Optional: restrict the app to a single spreadsheet
## If set, `/api/sheets` will only return tabs from this spreadsheet.
GOOGLE_SPREADSHEET_ID="your-spreadsheet-id"
